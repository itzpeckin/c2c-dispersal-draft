rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isCommissionerEmail() {
      return signedIn() &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == "justinrmandaro@gmail.com";
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isApprovedUser() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        currentUserDoc().data.status == "approved";
    }

    function isApprovedCommissioner() {
      return isApprovedUser() &&
        currentUserDoc().data.role == "commissioner";
    }

    function validAssignedEmail(team, email) {
      return
        (team == "YoByronWatkins" && email == "byronwatkins@gmail.com") ||
        (team == "erics2423" && email == "erics2423@yahoo.com") ||
        (team == "BenMoore13" && email == "biggtyme13@gmail.com") ||
        (team == "Vandorjp" && email == "joevandorn@gmail.com") ||
        (team == "LouGarou" && email == "nate.hagemann@gmail.com") ||
        (team == "BKnappy" && email == "bronsonknapp13@gmail.com") ||
        (team == "Tsummers3" && email == "trey.summers3@gmail.com") ||
        (team == "Peckin" && email == "justinrmandaro@gmail.com") ||
        (team == "Jonredcorn08" && email == "jstyner0425@email.campbell.edu") ||
        (team == "Jimmer44" && email == "jmiakisz@gmail.com") ||
        (team == "PiratesJs" && email == "bjcurrie12@gmail.com") ||
        (team == "CalBrewski" && email == "caleb.ds.lucas@gmail.com");
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isApprovedCommissioner());

      allow create: if signedIn() &&
        request.auth.uid == uid &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email.lower() &&
        validAssignedEmail(request.resource.data.requestedTeam, request.resource.data.email) &&
        (
          (
            isCommissionerEmail() &&
            request.resource.data.status == "approved" &&
            request.resource.data.role == "commissioner" &&
            request.resource.data.team == "Peckin"
          ) ||
          (
            !isCommissionerEmail() &&
            request.resource.data.status == "pending" &&
            request.resource.data.role == "member" &&
            request.resource.data.team == null
          )
        );

      allow update: if isApprovedCommissioner();
      allow delete: if false;
    }

    match /draft/main {
      allow read: if true;
      allow create: if isApprovedCommissioner();
      allow update: if isApprovedCommissioner() || (
        isApprovedUser() &&
        (
          (
            resource.data.status == "running" &&
            resource.data.currentOwner == currentUserDoc().data.team &&
            request.resource.data.currentPick == resource.data.currentPick + 1 &&
            request.resource.data.updatedBy == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "currentPick", "currentOwner", "status", "updatedAt", "updatedBy"
            ])
          ) ||
          (
            request.resource.data.updatedBy == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "pickOwners", "currentOwner", "updatedAt", "updatedBy"
            ])
          )
        )
      );
      allow delete: if false;
    }

    match /draftSelections/{pickId} {
      allow read: if true;
      allow create: if isApprovedUser() &&
        request.resource.data.draftedByUid == request.auth.uid &&
        request.resource.data.pickIndex == get(/databases/$(database)/documents/draft/main).data.currentPick &&
        request.resource.data.ownerTeam == get(/databases/$(database)/documents/draft/main).data.currentOwner &&
        (isApprovedCommissioner() || currentUserDoc().data.team == get(/databases/$(database)/documents/draft/main).data.currentOwner);
      allow update: if false;
      allow delete: if isApprovedCommissioner();
    }

    match /playerLocks/{playerId} {
      allow read: if isApprovedUser();
      allow create: if isApprovedUser() && request.resource.data.draftedByUid == request.auth.uid;
      allow update: if false;
      allow delete: if isApprovedCommissioner();
    }

    match /tradeOffers/{tradeId} {
      allow read: if true;

      allow create: if isApprovedUser() &&
        request.resource.data.status == "pending" &&
        request.resource.data.createdByUid == request.auth.uid &&
        (isApprovedCommissioner() || request.resource.data.fromTeam == currentUserDoc().data.team);

      allow update: if isApprovedCommissioner() || (
        isApprovedUser() &&
        resource.data.status == "pending" &&
        (
          (resource.data.toTeam == currentUserDoc().data.team && request.resource.data.status in ["accepted", "declined"]) ||
          (resource.data.fromTeam == currentUserDoc().data.team && request.resource.data.status == "cancelled")
        )
      );

      allow delete: if isApprovedCommissioner();
    }

    match /queues/{teamId} {
      allow read, create, update, delete: if isApprovedUser() && (
        isApprovedCommissioner() ||
        currentUserDoc().data.team == teamId
      );
    }

    match /presence/{uid} {
      allow read: if isApprovedUser();
      allow create, update, delete: if isApprovedUser() && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
